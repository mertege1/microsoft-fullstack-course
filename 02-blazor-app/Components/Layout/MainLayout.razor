@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <h5 class="mb-0 text-muted font-weight-bold" style="color: #6b7280; margin:0;">EventEase Portal</h5>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="app-footer">
            <p>Designed & Developed by <strong>Mert Ege Cetinkaya</strong></p>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>