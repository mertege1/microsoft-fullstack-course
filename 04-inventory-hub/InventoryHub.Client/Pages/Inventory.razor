@page "/inventory"
@inject HttpClient Http
@using InventoryHub.Client.Models

<PageTitle>Inventory Dashboard - InventoryHub</PageTitle>

<style>
    /* CSS Animations */
    .fade-in { animation: fadeIn 0.6s ease-in-out; }
    .slide-up { animation: slideUp 0.4s ease-out; }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    
    .modern-card {
        border-radius: 16px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        background: #ffffff;
        transition: transform 0.2s ease;
    }

    .widget-card {
        border-left: 5px solid #0d6efd;
    }
    
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }
</style>

<div class="container-fluid mt-4 fade-in">
    
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card modern-card widget-card p-3 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Total Inventory Value</h6>
                        <h3 class="fw-bold text-primary mb-0">@TotalInventoryValue.ToString("C")</h3>
                    </div>
                    <div class="fs-1 text-primary opacity-25">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card modern-card widget-card p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Critical Stock Items</h6>
                        <h3 class="fw-bold text-danger mb-0">@CriticalStockCount</h3>
                    </div>
                    <div class="fs-1 text-danger opacity-25">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card modern-card widget-card p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small font-weight-bold">Product Diversity</h6>
                        <h3 class="fw-bold text-success mb-0">@(products?.Count ?? 0) Types</h3>
                    </div>
                    <div class="fs-1 text-success opacity-25">
                        <i class="bi bi-boxes"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-0 py-2" placeholder="Search products by name..." @bind-value="searchTerm" @bind-value:event="oninput" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex gap-2">
                <button class="btn rounded-pill px-4 shadow-sm @(selectedCategory == "All" ? "btn-primary" : "btn-light bg-white")" @onclick='() => FilterByCategory("All")'>All</button>
                <button class="btn rounded-pill px-4 shadow-sm @(selectedCategory == "Electronics" ? "btn-primary" : "btn-light bg-white")" @onclick='() => FilterByCategory("Electronics")'>Electronics</button>
                <button class="btn rounded-pill px-4 shadow-sm @(selectedCategory == "Clothing" ? "btn-primary" : "btn-light bg-white")" @onclick='() => FilterByCategory("Clothing")'>Clothing</button>
                <button class="btn rounded-pill px-4 shadow-sm @(selectedCategory == "General" ? "btn-primary" : "btn-light bg-white")" @onclick='() => FilterByCategory("General")'>General</button>
            </div>
        </div>
    </div>

    <div class="row g-4">
        
        <div class="col-lg-8">
            <div class="card modern-card h-100 p-2">
                <div class="card-header bg-white border-0 pt-4 pb-2">
                    <h3 class="fw-bold text-dark mb-0">📦 Master Catalog</h3>
                    <p class="text-muted small">Manage, update, or remove your repository stock in real-time.</p>
                </div>
                
                <div class="card-body">
                    @if (products == null)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
                            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                                <span class="visually-hidden">Loading Data...</span>
                            </div>
                        </div>
                    }
                    else if (!FilteredProducts.Any())
                    {
                        <div class="alert alert-secondary border-0 rounded-4 text-center p-5">
                            <h4 class="mb-3">📭 No Products Found</h4>
                            <p class="mb-0">Try adjusting your search criteria or add a new record.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-borderless table-hover align-middle">
                                <thead class="border-bottom">
                                    <tr class="text-muted small text-uppercase">
                                        <th scope="col" class="pb-3">Product</th>
                                        <th scope="col" class="pb-3">Category</th>
                                        <th scope="col" class="pb-3">Price</th>
                                        <th scope="col" class="pb-3">Stock Status</th>
                                        <th scope="col" class="pb-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in FilteredProducts)
                                    {
                                        <tr class="border-bottom slide-up">
                                            <td class="fw-semibold py-3 text-dark">@product.Name</td>
                                            <td><span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">@product.Category</span></td>
                                            <td class="text-success fw-bold">@product.Price.ToString("C")</td>
                                            <td>
                                                @if (product.Quantity < 10)
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 border border-danger border-opacity-25">
                                                        🚨 Low Stock (@product.Quantity)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25">
                                                        ✅ In Stock (@product.Quantity)
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary rounded-circle me-1" title="Edit Product" @onclick="() => StartEdit(product)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger rounded-circle" title="Delete Product" @onclick="() => DeleteProduct(product.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4 slide-up">
            <div class="card modern-card bg-light p-2">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">@(isEditing ? "📝 Edit Product" : "➕ Add New Product")</h4>

                    @if (showSuccessMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="CloseMessage"></button>
                        </div>
                    }

                    <EditForm Model="newProduct" OnValidSubmit="HandleSubmit">
                        <div class="form-floating mb-3 shadow-sm rounded-3">
                            <InputText id="name" class="form-control border-0" @bind-Value="newProduct.Name" placeholder="Product Name" required />
                            <label for="name" class="text-muted">Product Name</label>
                        </div>

                        <div class="form-floating mb-3 shadow-sm rounded-3">
                            <select id="category" class="form-select border-0" @bind="newProduct.Category" required>
                                <option value="General">General</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Clothing">Clothing</option>
                            </select>
                            <label for="category" class="text-muted">Category</label>
                        </div>

                        <div class="form-floating mb-3 shadow-sm rounded-3">
                            <InputNumber id="price" class="form-control border-0" @bind-Value="newProduct.Price" placeholder="Price" required />
                            <label for="price" class="text-muted">Price</label>
                        </div>

                        <div class="form-floating mb-4 shadow-sm rounded-3">
                            <InputNumber id="qty" class="form-control border-0" @bind-Value="newProduct.Quantity" placeholder="Quantity" required />
                            <label for="qty" class="text-muted">Stock Quantity</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1 py-3 rounded-3 fw-bold shadow" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <span>@(isEditing ? "Save Changes" : "Add to Catalog")</span>
                                }
                            </button>
                            
                            @if (isEditing)
                            {
                                <button type="button" class="btn btn-secondary py-3 rounded-3 fw-bold" @onclick="CancelEdit">Cancel</button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private List<Product>? products;
    private Product newProduct = new();
    
    // UI & Search State
    private bool isSubmitting = false;
    private bool showSuccessMessage = false;
    private bool isEditing = false;
    private string searchTerm = "";
    private string selectedCategory = "All";
    private string successMessage = "";

    // Calculated Dashboard Metrics
    private decimal TotalInventoryValue => products?.Sum(p => p.Price * p.Quantity) ?? 0;
    private int CriticalStockCount => products?.Count(p => p.Quantity < 10) ?? 0;

    // Real-time Live Filter Logic
    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            if (products == null) return Enumerable.Empty<Product>();
            
            var query = products.AsEnumerable();

            if (selectedCategory != "All")
            {
                query = query.Where(p => p.Category == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        await Task.Delay(400); // Visual stability delay
        products = await Http.GetFromJsonAsync<List<Product>>("api/products");
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        showSuccessMessage = false;
        await Task.Delay(200);

        if (isEditing)
        {
            // Execute PUT request for updates
            var response = await Http.PutAsJsonAsync($"api/products/{newProduct.Id}", newProduct);
            if (response.IsSuccessStatusCode)
            {
                var index = products!.FindIndex(p => p.Id == newProduct.Id);
                if (index != -1)
                {
                    products[index] = newProduct; // Update Cache State
                }
                successMessage = "Product updated successfully!";
                showSuccessMessage = true;
                CancelEdit();
            }
        }
        else
        {
            // Execute POST request for creation
            var response = await Http.PostAsJsonAsync("api/products", newProduct);
            if (response.IsSuccessStatusCode)
            {
                var addedProduct = await response.Content.ReadFromJsonAsync<Product>();
                if (addedProduct != null)
                {
                    products?.Add(addedProduct); // Cache injection optimization
                }
                newProduct = new Product();
                successMessage = "Product added to catalog successfully!";
                showSuccessMessage = true;
            }
        }

        isSubmitting = false;
    }

    private void StartEdit(Product product)
    {
        isEditing = true;
        showSuccessMessage = false;
        // Deep clone to prevent direct binding tampering before save
        newProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Category = product.Category,
            Price = product.Price,
            Quantity = product.Quantity
        };
    }

    private void CancelEdit()
    {
        isEditing = false;
        newProduct = new Product();
    }

    private async Task DeleteProduct(int id)
    {
        var response = await Http.DeleteAsync($"api/products/{id}");
        if (response.IsSuccessStatusCode)
        {
            products?.RemoveAll(p => p.Id == id); // State Management Optimization
            successMessage = "Product removed from database.";
            showSuccessMessage = true;
        }
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
    }

    private void CloseMessage()
    {
        showSuccessMessage = false;
    }
}